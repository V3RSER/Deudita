# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NEXT_PUBLIC_APP_URL: The URL where this applet is hosted.
# Used for invite links, self-referential links, OAuth callbacks, and API endpoints (accessible on both client and server).
NEXT_PUBLIC_APP_URL=

# OPTIONAL SMTP EMAIL CONFIGURATION:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# SUPABASE CONFIGURATION:
# URL of your Supabase project (e.g. https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# SUPABASE / AWS S3 STORAGE CONFIGURATION:
# S3 Endpoint URL (e.g. https://<project-ref>.supabase.co/storage/v1/s3 or https://s3.<region>.amazonaws.com)
S3_ENDPOINT=
# S3 Region (e.g. us-east-1 or sa-east-1)
S3_REGION=us-east-1
# S3 Access Key ID / Supabase Access Key
S3_ACCESS_KEY_ID=
# S3 Secret Access Key / Supabase Secret Key
S3_SECRET_ACCESS_KEY=
# S3 Bucket Name (default: uploads)
S3_BUCKET_NAME=uploads

# OPTIONAL GMAIL INTEGRATION CONFIGURATION:
GMAIL_APPS_SCRIPT_ID=
GMAIL_APPS_SCRIPT_URL=
